# Copy to .env (docker compose loads that file automatically) or export the
# values in your shell. The server binary itself does not read .env: it reads
# plain environment variables.

# JWT signing key. src/auth.rs falls back to a hardcoded "abc" when this is
# unset, which is fine for local debugging only. Set a random value before the
# server is reachable by anyone else.
JWT_SECRET=change-me-before-exposing-the-server

# Selects config/<RUN_MODE> for src/config.rs. Optional; defaults to dev.
# RUN_MODE=dev
